<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/soc_surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_message_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_paste_phishing">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_message"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:gravity="top|start"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:scrollbars="vertical" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_extract"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/action_extract_artifacts" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sample"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_load_sample" />

                    <TextView
                        android:id="@+id/warning_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/severity_medium"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="URL was shortened and expanded." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/extraction_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/soc_surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/extracted_from_message"
                        android:textColor="@color/soc_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/extracted_urls_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/extracted_ips_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/soc_surface"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/result_host"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/soc_on_surface"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="paypa1-secure.com" />

                        <TextView
                            android:id="@+id/threat_status_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/soc_black"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="MALICIOUS" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/result_original_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/soc_on_surface_variant"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="As written: hxxps://paypa1-secure[.]com" />

                    <TextView
                        android:id="@+id/result_final_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/soc_on_surface_variant"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:visibility="gone"
                        tools:text="Final: http://203.0.113.9/login" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/soc_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_resolved_ips"
                            android:textColor="@color/soc_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/value_resolved_ips"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/soc_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="203.0.113.9" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vt_detections"
                            android:textColor="@color/soc_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/value_vt_detections"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/soc_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="3 / 31" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_redirects"
                            android:textColor="@color/soc_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/value_redirects"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/soc_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="2 hops" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categories_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_categories"
                            android:textColor="@color/soc_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/value_categories"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/severity_high"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="phishing" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/value_vt_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/vt_link"
                        android:textColor="@color/soc_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/redirect_chain_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/soc_on_surface_variant"
                        android:textSize="11sp"
                        android:textIsSelectable="true"
                        android:visibility="gone"
                        tools:text="1. bit.ly -&gt; 301\n2. evil.com -&gt; 302" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_investigate_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/action_investigate_ip"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/value_sources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/soc_on_surface_variant"
                        android:textSize="11sp"
                        tools:text="Sources: virustotal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/loading_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/error_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/severity_critical"
                    android:textSize="14sp"
                    tools:text="SOC backend is unreachable." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_url_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_retry" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>